# ============================================
# _HEADERS - Protection renforcée
# ============================================

/*
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdnjs.cloudflare.com https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; media-src 'self' https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), bluetooth=(), autoplay=()

/admin/*
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow, nosnippet

/*.json
  X-Robots-Tag: noindex, nofollow

/js/*
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=31536000, immutable

/css/*
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=31536000, immutable